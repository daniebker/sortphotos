<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.andrewning.sortphotos</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/sortphotos</string>  <!-- full path to the installed sortphotos command (see `which sortphotos`) -->
        <string>-m</string>
        <string>/Users/Me/Pictures/DumpHere</string>  <!-- full path to source directory -->
        <string>/Users/Me/Pictures</string>  <!-- full path to destination directory -->
    </array>
    <key>StartInterval</key>
    <integer>86400</integer>  <!-- how often sortphotos should execute (in seconds) -->
</dict>
</plist>